<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<!-- ORM провайдер для MySQL -->
		<PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />

		<!-- Явное указание безопасной версии драйвера (закрывает уязвимость) -->
		<PackageReference Include="MySqlConnector" Version="2.6.2" />

		<!-- Необходимо для работы миграций EF Core -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<!-- Infrastructure зависит только от Application (Clean Architecture) -->
		<ProjectReference Include="..\OnlineLearning.Application\OnlineLearning.Application.csproj" />
	</ItemGroup>

</Project>